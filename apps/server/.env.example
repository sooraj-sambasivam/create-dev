# Anthropic (generation). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Default claude-sonnet-5-5 (fast). claude-opus-5-5 for richer layouts at higher latency.
CLAUDE_MODEL=claude-sonnet-5-5
# Thinking effort: new pages (default medium) and edits (default low). low | medium | high
CLAUDE_BUILD_EFFORT=medium
CLAUDE_EDIT_EFFORT=low

# ElevenLabs Scribe (voice transcription). https://elevenlabs.io
ELEVENLABS_API_KEY=

# 1 = return a canned screen without calling any model (works with no keys)
MOCK_AI=1
PORT=3001

# TypeSafe Jev: typed intent judgments (optional; without it routing uses Haiku, then keywords)
TYPESAFE_API_KEY=
