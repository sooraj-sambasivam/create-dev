{
  "manifest_version": 3,
  "name": "Create: Point at any website",
  "version": "0.1.0",
  "description": "Point at any element on a page, say what you want, and open it as an editable Create prototype.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3001/*", "http://127.0.0.1:3001/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Point at this page (Alt+Shift+P)" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Arm pointer mode"
    }
  }
}
