{
  "name": "create-dev",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @create/server dev\" \"pnpm --filter @create/web dev\"",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "onboard": "node scripts/onboard.mjs",
    "share:tunnel": "node scripts/tunnel.mjs",
    "eval:pointer": "node eval/pointer/run.mjs",
    "video:capture": "node scripts/video/capture.mjs",
    "video:voice": "node --env-file=apps/server/.env scripts/video/voice.mjs",
    "video:assemble": "node scripts/video/assemble.mjs",
    "video:draft": "node scripts/video/capture.mjs && node --env-file=apps/server/.env scripts/video/voice.mjs && node scripts/video/assemble.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
